async function saveCustomerProfile() {
  const customer = window.currentCustomer;

  if (!customer) {
    showCustomerLogin();
    return;
  }

  const name = document.getElementById("customerProfileName").value.trim();
  const phone = document.getElementById("customerProfilePhone").value.trim();
  const message = document.getElementById("customerProfileMessage");

  if (!name || !phone) {
    message.textContent = "Name aur phone required hai.";
    return;
  }

  message.textContent = "Saving...";

  try {
    const response = await fetch("/api/customer/profile", {
      method: "PUT",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        customerId: customer.id,
        name: name,
        phone: phone
      })
    });

    const data = await response.json();

    if (!response.ok || !data.success) {
      message.textContent = data.message || "Profile update failed";
      return;
    }

    window.currentCustomer = data.customer;

    localStorage.setItem(
      "zcart_customer",
      JSON.stringify(data.customer)
    );

    message.textContent = "Profile updated successfully!";

    document.getElementById("customerDashboardName").textContent =
      data.customer.name;

    document.getElementById("customerDashboardEmail").textContent =
      "Email: " + data.customer.email;

    document.getElementById("customerDashboardPhone").textContent =
      "Phone: " + data.customer.phone;

  } catch (error) {
    console.error(error);
    message.textContent = "Server se connection nahi ho raha.";
  }
}

