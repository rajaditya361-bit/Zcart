<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZCart - Online Shopping</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f1f3f6;
            color: #222;
        }

        header {
            background: #2874f0;
            color: white;
            padding: 12px 5%;
            display: flex;
            align-items: center;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-btn {
            border: none;
            background: transparent;
            color: white;
            font-size: 24px;
            font-weight: bold;
            cursor: pointer;
            padding: 4px 8px;
            min-width: 40px;
        }

        .nav-btn:active {
            transform: scale(0.92);
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            white-space: nowrap;
            cursor: pointer;
        }

        .search {
            flex: 1;
            display: flex;
            max-width: 650px;
        }

        .search input {
            width: 100%;
            padding: 12px;
            border: none;
            outline: none;
            font-size: 15px;
        }

        .search button {
            padding: 0 18px;
            border: none;
            background: white;
            cursor: pointer;
            font-size: 18px;
        }

        .cart {
            font-weight: bold;
            white-space: nowrap;
            cursor: pointer;
        }

        .categories {
            background: white;
            padding: 15px 5%;
            display: flex;
            gap: 25px;
            overflow-x: auto;
            box-shadow: 0 1px 3px #ccc;
        }

        .category {
            min-width: 80px;
            text-align: center;
            cursor: pointer;
            font-weight: bold;
        }

        .category-icon {
            font-size: 30px;
            margin-bottom: 5px;
        }

        .banner {
            margin: 15px auto;
            width: 90%;
            max-width: 1200px;
            background: linear-gradient(90deg, #2874f0, #5fa8ff);
            color: white;
            padding: 35px;
            border-radius: 5px;
        }

        .banner h1 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .products {
            width: 90%;
            max-width: 1200px;
            margin: 20px auto;
        }

        .products h2 {
            background: white;
            padding: 18px;
            margin-bottom: 2px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
        }

        .product {
            background: white;
            padding: 15px;
            cursor: pointer;
            transition: 0.2s;
        }

        .product:hover {
            transform: translateY(-3px);
            box-shadow: 0 3px 10px #ccc;
        }

        .product-image {
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 80px;
            background: #fafafa;
            margin-bottom: 12px;
        }

        .product-name {
            font-size: 15px;
            margin-bottom: 8px;
        }

        .price {
            font-size: 20px;
            font-weight: bold;
        }

        .rating {
            display: inline-block;
            background: #388e3c;
            color: white;
            padding: 3px 7px;
            border-radius: 3px;
            font-size: 12px;
            margin: 7px 0;
        }

        .add-cart {
            width: 100%;
            padding: 10px;
            border: none;
            background: #ff9f00;
            color: white;
            font-weight: bold;
            cursor: pointer;
            border-radius: 3px;
        }

        footer {
            margin-top: 30px;
            background: #172337;
            color: white;
            padding: 40px 5%;
            text-align: center;
        }

        @media (max-width: 800px) {
            header {
                flex-wrap: wrap;
                gap: 10px;
            }

            .search {
                order: 3;
                flex-basis: 100%;
            }

            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .banner h1 {
                font-size: 24px;
            }

            .product-image {
                height: 140px;
                font-size: 60px;
            }
        }
    </style>
</head>

<body>

