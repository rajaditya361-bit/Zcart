<script>

async function loadProducts() {
    try {
        const response = await fetch("/api/products");
        const data = await response.json();
        window.zcartProducts = data.products;

        if (!data.success) return;

        const grid = document.getElementById("productGrid");

        data.products.forEach(product => {
            const card = document.createElement("div");
            card.className = "product";

            card.innerHTML = `
                <div class="product-image" onclick="showProductDetails('${product.id}')" style="cursor:pointer;">🛍️</div>
                <div class="product-name" onclick="showProductDetails('${product.id}')" style="cursor:pointer;">${product.name}</div>
                <div class="rating">★ ${product.rating || 0}</div>
                <div class="price">
                    ₹${Number(product.price).toLocaleString("en-IN")}
                </div>
                <br>
                <button class="add-cart"
                    onclick="addToCart('${product.id}', '${product.sellerId || ""}', '${product.name.replace(/'/g, "\\'")}', ${product.price})">
                    Add to Cart
                </button>
            `;

            grid.appendChild(card);
        });

    } catch (error) {
        console.error("Product loading failed:", error);
    }
}

loadProducts();
</script><script>

    // ZCart cross-platform navigation
    const zcartNavigation = {
        stack: ["home"],
        current: "home",
        ignorePopState: false
    };

    function zcartNavigate(screen) {
        if (zcartNavigation.current !== screen) {
            zcartNavigation.stack.push(screen);
            zcartNavigation.current = screen;
            history.pushState({ zcart: true, screen: screen }, "", "#" + screen);
        }
    }

    function zcartGoBack() {
        if (zcartNavigation.stack.length > 1) {
            history.back();
        } else {
            zcartGoHome();
        }
    }

    function zcartGoHome() {
        // Close all ZCart screens/modals
        document.querySelectorAll('[id$="Modal"]').forEach(el => {
            el.style.display = "none";
        });

        zcartNavigation.stack = ["home"];
        zcartNavigation.current = "home";

        // Replace the current state instead of creating a history loop
        history.replaceState(
            { zcart: true, screen: "home" },
            "",
            "#home"
        );

        window.scrollTo(0, 0);
    }

    window.addEventListener("popstate", function(event) {
        if (zcartNavigation.stack.length > 1) {
            zcartNavigation.stack.pop();
            zcartNavigation.current =
                zcartNavigation.stack[zcartNavigation.stack.length - 1];

            document.querySelectorAll('[id$="Modal"]').forEach(el => {
                el.style.display = "none";
            });

            const screen = zcartNavigation.current;

            if (screen === "wishlist") {
                showWishlist(true);
            } else if (screen === "productDetails") {
                document.getElementById("productModal").style.display = "block";
            } else if (screen === "cart") {
                document.getElementById("cartModal").style.display = "block";
            } else if (screen === "checkout") {
                document.getElementById("checkoutModal").style.display = "block";
            } else if (screen === "orders") {
                document.getElementById("ordersModal").style.display = "block";
            } else if (screen === "customerDashboard") {
                document.getElementById("customerDashboardModal").style.display = "block";
            } else if (screen === "customerProfile") {
                document.getElementById("customerProfileModal").style.display = "block";
            } else if (screen === "customerLogin") {
                document.getElementById("customerLoginModal").style.display = "block";
            } else if (screen === "customerSignup") {
                document.getElementById("customerSignupModal").style.display = "block";
            } else if (screen === "sellerLogin") {
                document.getElementById("sellerLoginModal").style.display = "block";
            } else if (screen === "sellerSignup") {
                document.getElementById("sellerSignupModal").style.display = "block";
            } else if (screen === "sellerDashboard") {
                document.getElementById("sellerDashboardModal").style.display = "block";
            }

            window.scrollTo(0, 0);
        } else {
            zcartGoHome();
        }
    });

    // Initial ZCart history state
    history.replaceState(
        { zcart: true, screen: "home" },
        "",
        "#home"
    );

    let cart = JSON.parse(localStorage.getItem("zcart_cart")) || [];
    function saveCart() {
        localStorage.setItem("zcart_cart", JSON.stringify(cart));
    }


    function addToCart(productId, sellerId, name, price) {
        const existing = cart.find(item =>
            String(item.productId) === String(productId)
        );

        if (existing) {
            existing.quantity++;
        } else {
            cart.push({
                productId: productId,
                sellerId: sellerId || "",
                name: name,
                price: Number(price),
                quantity: 1
            });
        }

        updateCart();
        saveCart();

        const toast = document.getElementById("cartToast");
        const toastName = document.getElementById("cartToastName");

        toastName.textContent = name;
        toast.style.display = "block";

        requestAnimationFrame(() => {
            toast.style.opacity = "1";
            toast.style.transform = "translate(-50%,0)";
        });

        clearTimeout(window.cartToastTimer);
        window.cartToastTimer = setTimeout(() => {
            toast.style.opacity = "0";
            toast.style.transform = "translate(-50%,20px)";

            setTimeout(() => {
                toast.style.display = "none";
            }, 250);
        }, 2500);
    }

    function updateCart() {
        const count = cart.reduce((sum, item) => sum + item.quantity, 0);
        document.getElementById("cartCount").innerText = count;

        const container = document.getElementById("cartItems");
        const totalElement = document.getElementById("cartTotal");

        if (cart.length === 0) {
            container.innerHTML = `
                <div style="background:#fff;border-radius:16px;padding:42px 20px;text-align:center;box-shadow:0 2px 10px rgba(0,0,0,.06);">
                    <div style="font-size:58px;margin-bottom:12px;">🛒</div>
                    <div style="font-size:20px;font-weight:800;color:#222;">Your cart is empty</div>
                    <div style="font-size:13px;color:#777;margin-top:7px;">Add products you love and they will appear here.</div>
                    <button onclick="closeCart()" style="margin-top:20px;border:none;border-radius:9px;background:#2874f0;color:#fff;padding:12px 24px;font-size:14px;font-weight:700;">Continue Shopping</button>
                </div>
            `;
            totalElement.innerText = "Total: ₹0";
            return;
        }

        let total = 0;

        container.innerHTML = cart.map((item, index) => {
            const itemTotal = item.price * item.quantity;
            total += itemTotal;

            const product = (window.zcartProducts || []).find(p =>
                String(p._id || p.id) === String(item.productId)
            );

            const image = product && product.image ? product.image : "";

            return `
                <div style="
                    background:#fff;
                    border-radius:14px;
                    padding:12px;
                    margin-bottom:10px;
                    box-shadow:0 2px 10px rgba(0,0,0,.07);
                    border:1px solid #f0f0f0;
                ">
                    <div style="display:flex;gap:12px;align-items:flex-start;">

                        <div style="
                            width:82px;
                            height:82px;
                            border-radius:10px;
                            background:#f5f6f8;
                            overflow:hidden;
                            flex-shrink:0;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                        ">
                            ${
                                image
                                ? `<img src="${image}" style="width:100%;height:100%;object-fit:cover;">`
                                : `<span style="font-size:35px;">🛍️</span>`
                            }
                        </div>

                        <div style="flex:1;min-width:0;">
                            <div style="
                                font-size:15px;
                                font-weight:700;
                                color:#222;
                                line-height:1.35;
                                margin-bottom:5px;
                            ">
                                ${item.name}
                            </div>

                            <div style="
                                font-size:17px;
                                font-weight:800;
                                color:#111;
                            ">
                                ₹${Number(item.price).toLocaleString("en-IN")}
                            </div>

                            <div style="
                                font-size:12px;
                                color:#777;
                                margin-top:3px;
                            ">
                                Subtotal: ₹${itemTotal.toLocaleString("en-IN")}
                            </div>
                        </div>

                        <button onclick="removeFromCart(${index})" style="
                            border:none;
                            background:#f5f5f5;
                            color:#777;
                            width:30px;
