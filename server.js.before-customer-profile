app.post("/api/products", async (req, res) => {
  const { name, price, category, description, image, stock, sellerId } = req.body;

  if (!name || price === undefined) {
    return res.status(400).json({
      success: false,
      message: "Product name and price are required"
    });
  }

  await db.read();

  const product = {
    id: Date.now(),
    name,
    sellerId: sellerId || null,
    price: Number(price),
    category: category || "",
    description: description || "",
    image: image || "",
    stock: Number(stock || 0),
    rating: 0,
    reviews: 0,
    createdAt: new Date().toISOString()
  };

  db.data.products.push(product);
  await db.write();

  res.status(201).json({
    success: true,
    product
  });
});

app.delete("/api/products/:id", async (req, res) => {
  const { id } = req.params;
  const { sellerId } = req.body;

  if (!sellerId) {
    return res.status(400).json({
      success: false,
      message: "Seller ID is required"
    });
  }

  await db.read();

  const index = db.data.products.findIndex(
    product =>
      String(product.id) === String(id) &&
      String(product.sellerId || "") === String(sellerId)
  );

  if (index === -1) {
    return res.status(404).json({
      success: false,
      message: "Product not found or not owned by this seller"
    });
  }

  const deletedProduct = db.data.products.splice(index, 1)[0];

  await db.write();

  res.json({
    success: true,
    message: "Product deleted successfully",
    product: deletedProduct
  });
});

app.put("/api/products/:id", async (req, res) => {
  const { id } = req.params;
  const { sellerId, name, price, category, description, image, stock } = req.body;

  if (!sellerId) {
    return res.status(400).json({
      success: false,
      message: "Seller ID is required"
    });
  }

  await db.read();

  const product = db.data.products.find(
    product =>
      String(product.id) === String(id) &&
      String(product.sellerId || "") === String(sellerId)
  );

  if (!product) {
    return res.status(404).json({
      success: false,
      message: "Product not found or not owned by this seller"
    });
  }

  if (name !== undefined) product.name = name;
  if (price !== undefined) product.price = Number(price);
  if (category !== undefined) product.category = category;
  if (description !== undefined) product.description = description;
  if (image !== undefined) product.image = image;
  if (stock !== undefined) product.stock = Number(stock);

  await db.write();

  res.json({
    success: true,
    message: "Product updated successfully",
    product
  });
});

